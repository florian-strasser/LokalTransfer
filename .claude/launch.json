{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "lokaltransfer-docs",
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "docs-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "lokaltransfer-docs",
        "preview",
        "--port",
        "4300"
      ],
      "port": 4300,
      "autoPort": false
    }
  ]
}
