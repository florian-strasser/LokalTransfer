# Only the sources needed to build should reach the daemon: everything below is
# either rebuilt inside the image, useless there, or must never be baked into a
# published layer.

node_modules
.output
.nuxt
.data

# Secrets. `.env` in particular would otherwise end up in a public image.
.env
.env.*
!.env.example

# Uploaded files and the test suite's scratch space — both are large and local.
storage
.test-storage

.git
.github
.vscode
.idea
.DS_Store
*.log
logs
coverage
test

# The documentation site. It is a workspace member, so `pnpm install` in the
# build resolves the lockfile without it — verified: none of its dependencies
# land in the app image. Excluding it here just keeps the build context small
# and stops a docs change busting the Docker layer cache.
docs
