# Copy to .env and adjust. Every value is read through Nuxt's runtimeConfig,
# which is the only way environment variables reliably reach a built Nuxt app.

# --- App ---------------------------------------------------------------------
NUXT_APP_NAME=LokalTransfer
# The public base URL. Download and magic links are built from this, so it must
# be the address recipients actually reach — not localhost, in production.
NUXT_APP_URL=http://localhost:3000
# UI and e-mail language: en or de
NUXT_LANGUAGE=de
# Timezone that dates are *displayed* in. Everything is stored in UTC.
NUXT_TIMEZONE=Europe/Berlin
# Log verbosity: debug | info | warn | error
NUXT_LOG_LEVEL=info

NUXT_PUBLIC_PRIVACY_URL=
NUXT_PUBLIC_IMPRINT_URL=

# --- Background ---------------------------------------------------------------
# Shown behind the composer, the download page and the sign-in screen. Either a
# full URL or a path to a file in public/ (e.g. /background.jpg). Senders can
# override this per transfer from the composer's share options.
NUXT_PUBLIC_BACKGROUND_IMAGE=
# Optional: makes the background clickable, for crediting a photographer or
# linking your own site. Only applies to this default, not to a sender's own
# background.
NUXT_PUBLIC_BACKGROUND_LINK=
NUXT_PUBLIC_BACKGROUND_CREDIT=

# --- Colours -----------------------------------------------------------------
# The interface is neutral (white/grey/black) plus exactly one accent colour.
# A full 50–950 ramp is derived from each hex at runtime, so these two values
# theme the entire app — buttons, links, focus rings, alerts, the logo, the
# favicon and e-mail.
#
# QUOTE THE HEX VALUES. An unquoted '#' starts a comment in a .env file, so
# NUXT_PUBLIC_COLOR_PRIMARY=#0066CC parses as an EMPTY value and the app silently
# falls back to its built-in default — it looks fine, but your colour is ignored.
# Quoting avoids that. (Writing the hex without the '#' also works.)
NUXT_PUBLIC_COLOR_PRIMARY="#CC0030"
NUXT_PUBLIC_COLOR_PRIMARY_DARK="#DE0F3B"
# The grey ramp. Keep it desaturated — chroma here is clamped, so a colourful
# value is greyed out rather than becoming a second accent.
NUXT_PUBLIC_COLOR_NEUTRAL="#71717A"
NUXT_PUBLIC_COLOR_NEUTRAL_DARK="#71717A"

# --- First administrator ------------------------------------------------------
# There is no public signup, so a fresh instance has no way to create its first
# admin through the UI. These seed one at startup.
#
# Only ever used when the instance has NO administrator: once one exists this is
# ignored, so a password you change in the app is never reverted to the value
# here. Safe to leave set — it also acts as a recovery hatch if the last admin is
# ever deleted. If the address already belongs to a team member, that account is
# promoted to admin and its password is left untouched.
#
# Alternative: leave these empty and run `pnpm create-admin "Name" you@example.com`.
NUXT_ADMIN_NAME=Administrator
NUXT_ADMIN_EMAIL=
NUXT_ADMIN_PASSWORD=

# --- Sessions ----------------------------------------------------------------
# How many days a team member stays signed in.
NUXT_SESSION_MAX_AGE_DAYS=7
# Guest sessions are short on purpose: a magic link is a one-off errand.
NUXT_GUEST_SESSION_MAX_AGE_HOURS=12
NUXT_MAGIC_LINK_MAX_AGE_MINUTES=30

# --- Storage and limits ------------------------------------------------------
# Where uploads live. Must NOT be inside public/ — files are served only through
# the token-checked download handler. Relative paths resolve from the app root.
NUXT_STORAGE_PATH=./storage
NUXT_MAX_FILE_SIZE_MB=2048
NUXT_MAX_FILES_PER_TRANSFER=50
# Default retention offered in the composer. 0 means no expiry.
NUXT_DEFAULT_RETENTION_DAYS=14
# Uploads that were started but never sent are swept after this many hours.
NUXT_DRAFT_MAX_AGE_HOURS=24
# How many hours before a transfer expires its sender is warned, once, that the
# files are about to be deleted. 0 switches the warning off. Transfers whose
# whole retention is shorter than this are skipped — a warning that arrives with
# the transfer itself is just noise.
NUXT_EXPIRY_WARNING_HOURS=24

# --- Database ----------------------------------------------------------------
#
# In Docker, this block is what chooses between the two arrangements. Leave
# NUXT_MYSQL_HOST empty (or localhost) and the container uses the MySQL it ships
# with, generating its own password on first run — nothing else here matters.
# Point it at a host and the container skips its built-in MySQL entirely, in
# which case the user, password and database below have to be right.
NUXT_MYSQL_HOST=localhost
NUXT_MYSQL_USER=root
NUXT_MYSQL_PASSWORD=root1234
NUXT_MYSQL_DATABASE=lokaltransfer
# Set true for a managed database that requires TLS (e.g. Mittwald).
NUXT_MYSQL_SSL=false
# Only set false if the server's certificate can't be verified against a public
# CA. Defaults to true.
NUXT_MYSQL_SSL_REJECT_UNAUTHORIZED=true

# --- E-mail ------------------------------------------------------------------
NUXT_EMAIL_HOST=mail.yourserver.de
NUXT_EMAIL_PORT=465
NUXT_EMAIL_SECURE=true
NUXT_EMAIL_USER=noreply@yourdomain.com
NUXT_EMAIL_PASS=
# Optional: shown as the From address when it differs from the SMTP login.
NUXT_EMAIL_FROM=
